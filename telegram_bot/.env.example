# --- Telegram ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Where to forward each fix request. @Tog991 must have started the bot at
# least once (a bot cannot DM a username it has never met). Put Tog991's
# numeric chat id here. To find it, have Tog991 message the bot and read the
# id the bot logs, or forward one of their messages to @userinfobot.
FORWARD_CHAT_ID=123456789
# Display handle, used only in messages. Kept in sync with FORWARD_CHAT_ID.
FORWARD_USERNAME=@Tog991

# --- GitHub ---
# A token with `repo` scope (classic) or issues:write (fine-grained) so the bot
# can open issues. Without it, the bot still works but only forwards to the
# maintainer and shows a prefilled "New issue" link instead of auto-filing.
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=HyperHLE
GITHUB_REPO=HyperHLE
# Issue template / labels applied to opened issues.
GITHUB_ISSUE_LABELS=app fix request

# --- Persistence ---
# Where user preferences (chosen language) are stored so they survive bot
# restarts. Defaults to bot_state.pickle next to the project.
#PERSISTENCE_FILE=/data/bot_state.pickle
